* text=auto

# sha256sum -c は CRLF だと失敗するため LF 固定(クラウド=Ubuntu で検証する前提)
SHA256SUMS text eol=lf
*.sh text eol=lf

# 加工GeoJSONは全環境でLF固定（ファイル内metadataのハッシュ検証を安定させる）
*.geojson text eol=lf

# 加工CSVも全環境でLF固定（Windows作業ツリーでCRLFになるとバイト一致の再現性テストが壊れるため）
*.csv text eol=lf

# 加工データのmeta.jsonも同じ理由でLF固定（将来バイト比較する場合に備える）
*.json text eol=lf

# 生成レポートもバイト一致テストの対象のためLF固定
doc/JOIN_VERIFICATION.md text eol=lf
doc/FACILITY_LINKAGE.md text eol=lf
doc/YOY_VERIFICATION.md text eol=lf

*.xlsx binary
*.pdf binary
*.zip binary
